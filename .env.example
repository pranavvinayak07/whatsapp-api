# Production & Coolify Environment Configuration
NODE_ENV=production

# Application Ports
DASHBOARD_PORT=4000
API_PORT=4001

# Database Configuration (PostgreSQL dedicated for WhatsApp)
DATABASE_URL=postgresql://whatsapp_user:change_this_strong_password@postgres:5432/vivegaa_whatsapp?schema=public

# Security & Encryption Secrets
SESSION_SECRET=generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
INTERNAL_API_KEY=vw_live_internal_service_key_here

# Persistent Storage Directories (Volume Mounts)
BAILEYS_AUTH_DIR=/app/auth
MEDIA_STORAGE_DIR=/app/media

# Domain & URLs
PUBLIC_APP_URL=https://whatsapp.vivegaaerp.in
NEXT_PUBLIC_API_URL=https://whatsapp.vivegaaerp.in/api

# WhatsApp Engine Configuration
WHATSAPP_PROVIDER=BAILEYS
LOG_LEVEL=info
MESSAGE_QUEUE_ENABLED=true
DEFAULT_COUNTRY_CODE=91

# Automation & Rate Limiting
MAX_MESSAGES_PER_MINUTE=20
QUEUE_WORKER_CONCURRENCY=2
WEBHOOK_RETRY_LIMIT=3
